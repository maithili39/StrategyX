# StrategyX Production Environment Configurations
# Copy this file to '.env' and modify variables for local development/deployment.

# 1. Database Configuration
# Defaults to local SQLite if left empty
DATABASE_URL=sqlite:///strategyx.db
# For production PostgreSQL integration:
# DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/strategyx

# 2. MLflow MLOps Configuration
# Defaults to local SQLite backend and local mlruns directory
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=ott_user_fatigue_predictions
# For remote MLflow server:
# MLFLOW_TRACKING_URI=http://mlflow-server:5000
